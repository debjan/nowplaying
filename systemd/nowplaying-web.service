# Replace {$HOME} placeholder with actual home folder
# Replace {$PROJECTS} with parent location of nowplaying code

[Unit]
Description=Now Playing Web Server (uvicorn)
After=nowplaying.service
Wants=nowplaying.service

[Service]
Type=simple
WorkingDirectory=/{$PROJECTS}/nowplaying
ExecStart=/{$HOME}/.local/bin/uv run uvicorn nowplaying.web:app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target

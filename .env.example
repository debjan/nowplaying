# Copy to .env and fill in real values.
# Real environment variables (systemd Environment=, shell exports) take
# precedence over this file.

# Optional path/port overrides (defaults live under the platform data dir:
# %LOCALAPPDATA%\nowplaying on Windows, ~/.local/share/nowplaying elsewhere):
# NOWPLAYING_DB=<data-dir>/nowplaying.db
# NOWPLAYING_COVER=<data-dir>/cover.png
# NOWPLAYING_HOST=0.0.0.0
# NOWPLAYING_PORT=4940

# Shared secret for the state-changing POST endpoints (/api/player/*,
# /api/feedback/*, /api/sleep/*, /api/settings). Leave empty to accept LAN
# callers without a token (the default). When set, a non-browser client (a
# script, curl, Home Assistant) must send it as X-Nowplaying-Token; the
# dashboard itself is same-origin and needs nothing.
# NOWPLAYING_TOKEN=

# Track source backend: 'dbus' (Linux: BlueZ + MPRIS) or 'windows' (Windows Media Session).
# Auto-detected from the OS when unset.
# NOWPLAYING_SOURCE=dbus

# Allow the yt-dlp YouTube search as the album-art fallback when an album can't
# be resolved on MusicBrainz. MusicBrainz / coverartarchive need no key and
# always come first.
# YT_DLP=0

# Auto-skip hated tracks (thumbs down) the next time they come up. On by
# default; set 0 to keep them playing.
# (The old SKIP_FOREVER flag still works as an alias for AUTOSKIP.)
# AUTOSKIP=1

# Contact User-Agent for ListenBrainz (the "similar tracks" dialog). The API
# asks for a descriptive UA with a way to reach you; the default points at the
# project repository.
# LISTENBRAINZ_USER_AGENT=nowplaying/1.0.0 (https://github.com/debjan/nowplaying)

# ListenBrainz listen submission (optional). Paste the user token from
# https://listenbrainz.org/settings/ to submit listens once a track has played
# for LISTENBRAINZ_MIN_PLAY seconds (default 30). The token is a secret: keep it
# in .env, never in a systemd unit. Without a token the app only reads
# ListenBrainz (similar tracks).
# LISTENBRAINZ_TOKEN=
# Set to 0 to disable submission even with a token (e.g. on a dev machine that
# shares .env with the Pi). Love/hate feedback uses the same token.
# LISTENBRAINZ_SUBMIT=1
# Seconds a track must play before a listen is submitted.
# LISTENBRAINZ_MIN_PLAY=30

# Fixed UI theme: a CSS file name from web/themes, with or without the `.css`
# suffix (e.g. nord-polar-night or nord-polar-night.css). Leave unset to follow the OS colour
# scheme with the adaptive light/dark palettes generated from the album art.
# THEME=nord-polar-night

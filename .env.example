# Copy to .env and fill in real values (do NOT commit .env).
# Real environment variables (systemd Environment=, shell exports) take
# precedence over this file.

# Optional path/port overrides (defaults shown):
# NOWPLAYING_DB=~/.local/share/nowplaying/nowplaying.db
# NOWPLAYING_COVER=~/.local/share/nowplaying/cover.png
# NOWPLAYING_HOST=0.0.0.0
# NOWPLAYING_PORT=4940

# Allow the yt-dlp YouTube search as the album-art fallback when an album can't
# be resolved on MusicBrainz. MusicBrainz / coverartarchive need no key and
# always come first.
# YT_DLP=0

# Auto-skip tracks that have been skipped (via Next) 3 or more times.
# Skip counting always happens; this flag enables the auto-skip itself.
# SKIP_FOREVER=0

# Consider a track "loved" when it's been Previous-ed 3+ times while playing;
# a loved track's Title row shows a heart icon. Favourites counting always
# happens; this flag gates the loved/heart display.
# PREVIOUS_LOVE=0
